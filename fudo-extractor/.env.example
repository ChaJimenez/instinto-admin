# Fudo API Credentials
# Fudo autentica con POST /auth (apiKey + apiSecret) -> token Bearer.
# Ambos valores se obtienen en Fudo: Administración > Usuarios > API Key / API Secret
FUDO_API_KEY=MUAzNjQ4NTM=
FUDO_API_SECRET=your_api_secret_here
FUDO_BASE_URL=https://api.fu.do/v1alpha1

# Google Drive (para guardar reportes)
GOOGLE_DRIVE_FOLDER_ID=1JVBd0x-pT3DjA7pbk4PM0_u72HM0m1Nz

# Basecamp (para reportes)
# Proyecto "Administración" — reemplaza al viejo "Operaciones Instinto"
# (bucket 46274090) para mensajes/reportes. Si estos IDs no coinciden con el
# bucket/hilo que realmente ves en Basecamp, los cortes se publican en un
# mensaje invisible para ti sin dar ningún error (así pasó el 2026-09-10).
BASECAMP_ACCOUNT_ID=5484659
BASECAMP_BUCKET_ID=32427345
BASECAMP_MESSAGE_ID=10289129219
BASECAMP_INVENTORY_MESSAGE_ID=10289204960
# Hilo fijo de reportes semanales, confirmado por Carlos:
# https://3.basecamp.com/5484659/buckets/32427345/messages/10289153902
BASECAMP_WEEKLY_MESSAGE_ID=10289153902

# Forwards de facturas (correos reenviados) — confirmado por Carlos que
# SÍ viven en el proyecto viejo "Operaciones Instinto" (bucket 46274090),
# no en "Administración". Es donde Carlos revisa las facturas todos los
# días. IDs tomados de:
# https://3.basecamp.com/5484659/buckets/46274090/inboxes/10191373652
BASECAMP_FORWARDS_BUCKET_ID=46274090
BASECAMP_FORWARDS_INBOX_ID=10191373652
# En false hasta terminar el conteo físico de inventario en Fudo — evita
# publicar alertas de stock negativo generalizado que todavía no son reales.
INVENTORY_ALERTS_ENABLED=false

# Configuración
DATA_OUTPUT_DIR=./data
LOG_DIR=./logs
